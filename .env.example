# AgentHarbor environment configuration
#
# Copy to .env in the repository root. Values already set in the process
# environment win over this file.
#
# TIP: Run 'agentharbor status' to see your current configuration.

# =============================================================================
# SERVER
# =============================================================================

# Backend server port (Express API + WebSocket server)
SERVER_PORT=3001
# Vite dev server port (npm run dev only)
VITE_PORT=5173

# Address to bind to. There is no TLS built in: use a LAN/VPN address or
# 127.0.0.1 behind a TLS reverse proxy rather than exposing the port publicly.
HOST=0.0.0.0

# Path to the SQLite database with the login account and app settings
# Default: ~/.agentharbor/auth.db
# DATABASE_PATH=/path/to/auth.db

# =============================================================================
# AGENTS (Claude Code in tmux)
# =============================================================================

# tmux session whose windows hold the agents
# AH_TMUX_SESSION=main

# Claude Code command. A path ending in .exe selects the Windows claude.exe via
# WSL interop and enables Windows <-> WSL path translation.
# AH_CLAUDE_CMD=claude
# AH_CLAUDE_CMD=/mnt/c/Users/<you>/.local/bin/claude.exe

# Extra flags appended to every Claude launch
# AH_CLAUDE_ARGS=--permission-mode default

# Claude Code config directory (for Windows Claude: /mnt/c/Users/<you>/.claude)
# Default: ~/.claude
# CLAUDE_CONFIG_DIR=/home/<you>/.claude

# AgentHarbor state directory; must be writable by the Claude process
# (for Windows Claude: a /mnt/c/... path)
# Default: ~/.agentharbor
# AH_STATE_DIR=/home/<you>/.agentharbor

# Close Claude windows idle for this many minutes (0 = never). A menu waiting
# for an answer, running work or an open viewer keeps a window open.
# Default only: a value saved in Settings -> Agents -> Runtime wins.
# AH_IDLE_CLOSE_MINUTES=60

# Delete the copies of pasted files made for a Windows Claude after this many
# days. Default only, like the one above.
# AH_ATTACHMENT_RETENTION_DAYS=7

# Remind an agent whose turn is over that a background command is still
# running after this many minutes, then after doubling gaps (0 = never).
# Default only, like the ones above.
# AH_BACKGROUND_REMINDER_MINUTES=60

# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000
